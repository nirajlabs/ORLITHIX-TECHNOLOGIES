# Orlithix Technologies - Environment Configuration Template
# Copy this file to .env.local for local development. Do not commit .env.local to Git.

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Orlithix Technologies"
NEXT_PUBLIC_APP_TAGLINE="Engineering Intelligence. Building the Future."

# Contact Inquiries & Notification Endpoint
# Configure these if routing contact form submissions to a transactional mailer or webhook
CONTACT_NOTIFICATION_EMAIL=inquiries@orlithix.com
CONTACT_WEBHOOK_URL=

# Environment
NODE_ENV=development
